        <mxCell id="edge_invitem_item" edge="1" parent="1" source="inv_item_item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="JXMNVE_-JRXyASBiuB6P-180">
