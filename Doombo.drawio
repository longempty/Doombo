        <mxCell id="edge_equip_char" edge="1" parent="1" source="aidSqVbqEgVGXthLOxOh-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cziWY0EkAAtVQsHl7tzw-2">
