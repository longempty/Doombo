 (+ / −)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="146" /></mxCell><mxCell id="cl_balance" parent="tbl_currency_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Balance_After (BIGINT)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="176" /></mxCell><mxCell id="cl_reason" parent="tbl_currency_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Reason (varchar)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="206" /></mxCell><mxCell id="cl_ref" parent="tbl_currency_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Ref_ID (BIGINT, NULL)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="236" /></mxCell><mxCell id="cl_at" parent="tbl_currency_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Created_At (TIMESTAMPTZ)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="266" /></mxCell><mxCell id="note_rule_log" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#FF0000;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Rule – Log (phát triển sau)&lt;/b&gt;&lt;br&gt;Item_Log / Currency_Log ghi trong cùng transaction với thao tác; không đặt FK để log vẫn còn khi Item / Character đã bị xóa. Dùng để truy vết mất đồ, bug nhân bản, gian lận." vertex="1"><mxGeometry x="2540" y="1470" width="560" height="90" as="geometry" /></mxCell><mxCell id="tbl_npc_spawn" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;fillColor=light-dark(#FFF2CC,#CCCC00);" value="NPC_Spawn" vertex="1"><mxGeometry x="2540" y="1580" width="290" height="266" as="geometry" /></mxCell><mxCell id="ns_id" parent="tbl_npc_spawn" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="NPC_Spawn_ID (int, PK)" vertex="1"><mxGeometry width="290" height="30" as="geometry" y="26" /></mxCell><mxCell id="ns_npc" parent="tbl_npc_spawn" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="NPC_ID (int, FK)" vertex="1"><mxGeometry width="290" height="30" as="geometry" y="56" /></mxCell><mxCell id="ns_region" parent="tbl_npc_spawn" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Region_ID (int, FK, NULL)" vertex="1"><mxGeometry width="290" height="30" as="geometry" y="86" /></mxCell><mxCell id="ns_dungeon" parent="tbl_npc_spawn" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Dungeon_ID (int, FK, NULL)" vertex="1"><mxGeometry width="290" height="30" as="geometry" y="116" /></mxCell><mxCell id="ns_chance" parent="tbl_npc_spawn" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Spawn_Chance (numeric)  (%)" vertex="1"><mxGeometry width="290" height="30" as="geometry" y="146" /></mxCell><mxCell id="ns_check" parent="tbl_npc_spawn" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Check_Interval (int)  (phút)" vertex="1"><mxGeometry width="290" height="30" as="geometry" y="176" /></mxCell><mxCell id="ns_stay" parent="tbl_npc_spawn" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Stay_Duration (int)  (phút)" vertex="1"><mxGeometry width="290" height="30" as="geometry" y="206" /></mxCell><mxCell id="ns_quality" parent="tbl_npc_spawn" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Stock_Quality_Min (int)&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#0050EF;&quot;&gt;&lt;b&gt;(link Lookup_Code)&lt;/b&gt;&lt;/span&gt;" vertex="1"><mxGeometry width="290" height="30" as="geometry" y="236" /></mxCell><mxCell id="note_rule_npc_spawn" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#FF0000;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Rule – Thương nhân lang thang (phát triển sau)&lt;/b&gt;&lt;br&gt;1. NPC_Type = TRAVELING_MERCHANT, NPC.Region_ID = NULL; nơi có thể xuất hiện khai báo ở NPC_Spawn (map hoặc Dungeon).&lt;br&gt;2. Mỗi Check_Interval phút random theo Spawn_Chance; xuất hiện thì ở lại Stay_Duration phút rồi biến mất.&lt;br&gt;3. Khi xuất hiện: sinh hàng Vendor với Quality ≥ Stock_Quality_Min (đồ quý, không mua được ở Vendor thường); biến mất thì xóa hàng." vertex="1"><mxGeometry x="2850" y="1580" width="250" height="280" as="geometry" /></mxCell><mxCell id="tbl_character_dungeon" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;fillColor=light-dark(#FFF2CC,#CCCC00);" value="Character_Dungeon" vertex="1"><mxGeometry x="2840" y="2020" width="260" height="176" as="geometry" /></mxCell><mxCell id="cdg_char" parent="tbl_character_dungeon" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Character_ID (BIGINT, PK/FK)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="26" /></mxCell><mxCell id="cdg_dungeon" parent="tbl_character_dungeon" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Dungeon_ID (int, PK/FK)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="56" /></mxCell><mxCell id="cdg_count" parent="tbl_character_dungeon" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Clear_Count (int)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="86" /></mxCell><mxCell id="cdg_best" parent="tbl_character_dungeon" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Best_Time (int)  (giây)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="116" /></mxCell><mxCell id="cdg_last" parent="tbl_character_dungeon" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Last_Clear_At (TIMESTAMPTZ)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="146" /></mxCell><mxCell id="note_lk_status_type" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#FF0000;align=left;spacingLeft=6;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Status_Type&lt;/b&gt;&lt;br&gt;Lookup_Object = STATUS_TYPE&lt;br&gt;1 – BUFF&lt;br&gt;2 – DEBUFF (VD làm chậm)&lt;br&gt;3 – DOT (độc, bỏng, chảy máu)&lt;br&gt;4 – HOT (hồi máu theo thời gian)&lt;br&gt;5 – CC (choáng, đóng băng)" vertex="1"><mxGeometry x="3420" y="2428" width="280" height="138" as="geometry" /></mxCell><mxCell id="note_lk_effect_target" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#FF0000;align=left;spacingLeft=6;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Effect_Target&lt;/b&gt;&lt;br&gt;Lookup_Object = EFFECT_TARGET&lt;br&gt;1 – SELF&lt;br&gt;2 – ENEMY&lt;br&gt;3 – AREA_ENEMY&lt;br&gt;4 – AREA_ALLY" vertex="1"><mxGeometry x="3420" y="2582" width="280" height="122" as="geometry" /></mxCell><mxCell id="note_lk_chest_type" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#FF0000;align=left;spacingLeft=6;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Chest_Type&lt;/b&gt;&lt;br&gt;Lookup_Object = CHEST_TYPE&lt;br&gt;1 – NORMAL&lt;br&gt;2 – RARE&lt;br&gt;3 – BOSS" vertex="1"><mxGeometry x="3420" y="2720" width="280" height="106" as="geometry" /></mxCell><mxCell id="note_lk_quest_type" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#FF0000;align=left;spacingLeft=6;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Quest_Type&lt;/b&gt;&lt;br&gt;Lookup_Object = QUEST_TYPE&lt;br&gt;1 – MAIN&lt;br&gt;2 – SIDE&lt;br&gt;3 – DAILY&lt;br&gt;4 – EVENT" vertex="1"><mxGeometry x="3420" y="2842" width="280" height="122" as="geometry" /></mxCell><mxCell id="note_lk_objective_type" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#FF0000;align=left;spacingLeft=6;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Objective_Type&lt;/b&gt;&lt;br&gt;Lookup_Object = QUEST_OBJECTIVE_TYPE&lt;br&gt;1 – KILL (Target = Creep_ID)&lt;br&gt;2 – COLLECT (Target = Item_Basic_ID)&lt;br&gt;3 – TALK (Target = NPC_ID)&lt;br&gt;4 – REACH (Target = Region_ID)" vertex="1"><mxGeometry x="3420" y="2980" width="280" height="122" as="geometry" /></mxCell><mxCell id="note_lk_quest_status" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#FF0000;align=left;spacingLeft=6;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Quest_Status&lt;/b&gt;&lt;br&gt;Lookup_Object = QUEST_STATUS&lt;br&gt;1 – ACCEPTED&lt;br&gt;2 – COMPLETED&lt;br&gt;3 – REWARDED" vertex="1"><mxGeometry x="3420" y="3118" width="280" height="106" as="geometry" /></mxCell><mxCell id="note_lk_reward_type" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#FF0000;align=left;spacingLeft=6;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Reward_Type&lt;/b&gt;&lt;br&gt;Lookup_Object = REWARD_TYPE&lt;br&gt;1 – EXP&lt;br&gt;2 – GOLD&lt;br&gt;3 – DIAMOND&lt;br&gt;4 – ITEM" vertex="1"><mxGeometry x="3420" y="3240" width="280" height="122" as="geometry" /></mxCell><mxCell id="note_lk_achievement_cond" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#FF0000;align=left;spacingLeft=6;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Condition_Type (Achievement)&lt;/b&gt;&lt;br&gt;Lookup_Object = ACHIEVEMENT_CONDITION&lt;br&gt;1 – KILL_CREEP (Target = Creep_ID)&lt;br&gt;2 – REACH_LEVEL&lt;br&gt;3 – COMPLETE_QUEST (Target = Quest_ID, NULL = bất kỳ)&lt;br&gt;4 – COLLECT_QUALITY (Target = Quality)&lt;br&gt;5 – OPEN_CHEST&lt;br&gt;6 – CLEAR_DUNGEON (phát triển sau)" vertex="1"><mxGeometry x="3420" y="3378" width="280" height="154" as="geometry" /></mxCell></root>
