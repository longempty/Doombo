        <mxCell id="note_skill_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Skill unlock rule:&lt;br&gt;1. Class_Skill = class may learn skill + required character level&lt;br&gt;2. Class_Skill_Prerequisite = links a target Class_Skill to its prerequisite Class_Skill + required skill level&lt;br&gt;3. Character_Skill_Learned = character has actually learned it&lt;br&gt;4. Character_Skill_Slot references learned skill, so only learned skills can be equipped" vertex="1">
          <mxGeometry height="140" width="330" x="-395" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="note_class_evol" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=light-dark(#E1D5E7,#666666);strokeColor=#9673a6;" value="Class evolution:&lt;br&gt;Warrior at Character Lv 20&lt;br&gt;Barbarian at Character Lv 40&lt;br&gt;Guardian at Character Lv 40&lt;br&gt;Use From_Class_ID → To_Class_ID so one class can branch into multiple classes." vertex="1">
          <mxGeometry height="120" width="270" x="-360" y="1370" as="geometry" />
        </mxCell>
