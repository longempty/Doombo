      <mxCell id="tbl_level_exp" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;" value="Level_Exp" vertex="1"><mxGeometry x="-320" y="-440" width="300" height="116" as="geometry" /></mxCell><mxCell id="le_level" parent="tbl_level_exp" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Level (int, PK)" vertex="1"><mxGeometry width="300" height="30" as="geometry" y="26" /></mxCell><mxCell id="le_exp" parent="tbl_level_exp" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Exp_Required (BIGINT)  (exp để lên level kế)" vertex="1"><mxGeometry width="300" height="30" as="geometry" y="56" /></mxCell><mxCell id="le_sp" parent="tbl_level_exp" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Skill_Point_Reward (int)" vertex="1"><mxGeometry width="300" height="30" as="geometry" y="86" /></mxCell><mxCell id="tbl_game_config" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;" value="Game_Config" vertex="1"><mxGeometry x="-320" y="-640" width="330" height="146" as="geometry" /></mxCell><mxCell id="gc_key" parent="tbl_game_config" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Config_Key (varchar, PK)" vertex="1"><mxGeometry width="330" height="30" as="geometry" y="26" /></mxCell><mxCell id="gc_value" parent="tbl_game_config" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Config_Value (varchar)" vertex="1"><mxGeometry width="330" height="30" as="geometry" y="56" /></mxCell><mxCell id="gc_desc" parent="tbl_game_config" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Description (text)" vertex="1"><mxGeometry width="330" height="30" as="geometry" y="86" /></mxCell><mxCell id="gc_updated" parent="tbl_game_config" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Updated_At (TIMESTAMPTZ)" vertex="1"><mxGeometry width="330" height="30" as="geometry" y="116" /></mxCell><mxCell id="note_game_config" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#FF0000;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Game_Config – key mẫu&lt;/b&gt; (thay cho các &quot;hằng số package&quot; trước đây)&lt;br&gt;RESIST_CAP = 75 · DEFENSE_K = 100&lt;br&gt;INVENTORY_GRID = 10×4 · CHEST_GRID = 10×10 · VENDOR_GRID = 10×10&lt;br&gt;CHEST_TAB_MAX = 5 · MAX_CHARACTER_SLOT = 4&lt;br&gt;VENDOR_PRICE_RATE = 1.2 · BUYBACK_RATE = 2&lt;br&gt;QUALITY_SPAWN_RATE = 80 / 15 / 4 / 1 (NORMAL → LEGENDARY)&lt;br&gt;DAILY_RESET_TIME = 00:00" vertex="1"><mxGeometry x="30" y="-720" width="520" height="200" as="geometry" /></mxCell><mxCell id="tbl_class_stat_growth" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;" value="Class_Stat_Growth" vertex="1"><mxGeometry x="60" y="1500" width="300" height="116" as="geometry" /></mxCell><mxCell id="csg_class" parent="tbl_class_stat_growth" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Class_ID (BIGINT, PK/FK)" vertex="1"><mxGeometry width="300" height="30" as="geometry" y="26" /></mxCell><mxCell id="csg_stat" parent="tbl_class_stat_growth" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Stat_Code (int, PK)&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#0050EF;&quot;&gt;&lt;b&gt;(link Lookup_Code)&lt;/b&gt;&lt;/span&gt;" vertex="1"><mxGeometry width="300" height="30" as="geometry" y="56" /></mxCell><mxCell id="csg_value" parent="tbl_class_stat_growth" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Value_Per_Level (numeric)" vertex="1"><mxGeometry width="300" height="30" as="geometry" y="86" /></mxCell><mxCell id="edge_csg_class" edge="1" parent="1" source="csg_class" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="cziWY0EkAAtVQsHl7tzw-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tbl_region_chest" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;" value="Region_Chest" vertex="1"><mxGeometry x="2170" y="750" width="260" height="296" as="geometry" /></mxCell><mxCell id="rch_id" parent="tbl_region_chest" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Region_Chest_ID (int, PK)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="26" /></mxCell><mxCell id="rch_region" parent="tbl_region_chest" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Region_ID (int, FK)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="56" /></mxCell><mxCell id="rch_type" parent="tbl_region_chest" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Chest_Type (int)&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#0050EF;&quot;&gt;&lt;b&gt;(link Lookup_Code)&lt;/b&gt;&lt;/span&gt;" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="86" /></mxCell><mxCell id="rch_max" parent="tbl_region_chest" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Max_Spawn (int)" vertex="1"><mxGeometry width="260" height="30" as="geometry" y="116" /></mxCell><mxCell id="rch_respawn" parent="tbl_region_chest" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;r