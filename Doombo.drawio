        <mxCell id="edge_inventory_char" edge="1" parent="1" source="inv_item_inv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cziWY0EkAAtVQsHl7tzw-2">
          <mxGeometry relative="1" x="-0.0118" as="geometry">
