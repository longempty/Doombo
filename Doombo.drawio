        <mxCell id="edge_equip_item" edge="1" parent="1" source="aidSqVbqEgVGXthLOxOh-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="JXMNVE_-JRXyASBiuB6P-180">
