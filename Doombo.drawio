metry" /></mxCell><mxCell id="edge_qo_quest" edge="1" parent="1" source="qo_quest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="JXMNVE_-JRXyASBiuB6P-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_qr_quest" edge="1" parent="1" source="qr_quest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="JXMNVE_-JRXyASBiuB6P-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_qr_item" edge="1" parent="1" source="qr_item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="E8S67BiSvyNXWUljgaMx-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_cq_char" edge="1" parent="1" source="cq_char" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="cziWY0EkAAtVQsHl7tzw-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_cq_quest" edge="1" parent="1" source="cq_quest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="JXMNVE_-JRXyASBiuB6P-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_cqp_cq" edge="1" parent="1" source="cqp_char" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="cq_char"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_cqp_obj" edge="1" parent="1" source="cqp_no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="qo_no"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tbl_character_achievement" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;" value="Character_Achievement" vertex="1"><mxGeometry x="4130" y="1730" width="340" height="176" as="geometry" /></mxCell><mxCell id="ca_char" parent="tbl_character_achievement" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Character_ID (BIGINT, PK/FK)" vertex="1"><mxGeometry width="340" height="30" as="geometry" y="26" /></mxCell><mxCell id="ca_ach" parent="tbl_character_achievement" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Achievement_ID (int, PK/FK)" vertex="1"><mxGeometry width="340" height="30" as="geometry" y="56" /></mxCell><mxCell id="ca_progress" parent="tbl_character_achievement" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Progress (int)" vertex="1"><mxGeometry width="340" height="30" as="geometry" y="86" /></mxCell><mxCell id="ca_completed" parent="tbl_character_achievement" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Completed_At (TIMESTAMPTZ, NULL)" vertex="1"><mxGeometry width="340" height="30" as="geometry" y="116" /></mxCell><mxCell id="ca_rewarded" parent="tbl_character_achievement" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Rewarded_At (TIMESTAMPTZ, NULL)  (NULL = chưa nhận)" vertex="1"><mxGeometry width="340" height="30" as="geometry" y="146" /></mxCell><mxCell id="edge_ach_item" edge="1" parent="1" source="ach_reward_item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="E8S67BiSvyNXWUljgaMx-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_ca_char" edge="1" parent="1" source="ca_char" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="cziWY0EkAAtVQsHl7tzw-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_ca_ach" edge="1" parent="1" source="ca_ach" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="YVxcspwUH4dH9gIVws8s-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note_rule_quest" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#FF0000;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Rule – Quest / Achievement&lt;/b&gt;&lt;br&gt;1. Quest_Type: MAIN (tuyến chính, nối nhau bằng Prerequisite_Quest_ID), SIDE (phụ), DAILY (reset mỗi ngày lúc Game_Config DAILY_RESET_TIME: Character_Quest + Progress của quest DAILY được làm lại), EVENT (chỉ nhận trong Event_Start_At – Event_End_At).&lt;br&gt;2. Nhận quest khi Character.Level ≥ Required_Level và quest tiên quyết đã REWARDED; tiến độ từng mục tiêu lưu ở Character_Quest_Progress.&lt;br&gt;3. Quest thu thập: Objective COLLECT, Target_ID = Item_Basic có Item_Type QUEST_ITEM; nộp cho Return_NPC_ID (NULL = NPC giao) → DELETE các Item đó → COMPLETED → nhận thưởng → REWARDED.&lt;br&gt;4. Phần thưởng (Quest_Reward, Achievement): EXP / GOLD vào Character, DIAMOND vào Account (nguồn Diamond hiện tại chỉ từ Quest + Achievement), ITEM → sinh Item mới vào Inventory (đủ chỗ mới nhận).&lt;br&gt;5. Achievement theo Character: Progress cộng dồn theo Condition_Type; đạt Target_Value → Completed_At; bấm nhận → Rewarded_At." vertex="1"><mxGeometry x="3760" y="2070" width="710" height="300" as="geometry" /></mxCell><mxCell id="edge_css_char" edge="1" parent="1" source="css_char" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="cziWY0EkAAtVQsHl7tzw-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tbl_item_log" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;fillColor=light-dark(#FFF2CC,#CCCC00);" value="Item_Log" vertex="1"><mxGeometry x="2540" y="1160" width="280" height="266" as="geometry" /></mxCell><mxCell id="il_id" parent="tbl_item_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Item_Log_ID (BIGINT, PK)" vertex="1"><mxGeometry width="280" height="30" as="geometry" y="26" /></mxCell><mxCell id="il_item" parent="tbl_item_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Item_ID (BIGINT)" vertex="1"><mxGeometry width="280" height="30" as="geometry" y="56" /></mxCell><mxCell id="il_basic" parent="tbl_item_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Item_Basic_ID (int)" vertex="1"><mxGeometry width="280" height="30" as="geometry" y="86" /></mxCell><mxCell id="il_char" parent="tbl_item_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Character_ID (BIGINT, NULL)" vertex="1"><mxGeometry width="280" height="30" as="geometry" y="116" /></mxCell><mxCell id="il_action" parent="tbl_item_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Action (varchar)  (DROP / BUY / SELL / MOVE…)" vertex="1"><mxGeometry width="280" height="30" as="geometry" y="146" /></mxCell><mxCell id="il_from" parent="tbl_item_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="From_Location (varchar)" vertex="1"><mxGeometry width="280" height="30" as="geometry" y="176" /></mxCell><mxCell id="il_to" parent="tbl_item_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="To_Location (varchar)" vertex="1"><mxGeometry width="280" height="30" as="geometry" y="206" /></mxCell><mxCell id="il_at" parent="tbl_item_log" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Created_At (TIMESTAMPTZ)" vertex="1"><mxGeometry width="280" height="30" as="geometry" y="236" /></mxCell><mxCell id="tbl_currency_log" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParen