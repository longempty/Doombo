        <mxCell id="dcreep_dungeon" parent="tbl_dungeon_creep" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Dungeon_ID (int, PK/FK)" vertex="1">
