olor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Duration (numeric)  (giây, NULL = vĩnh viễn)" vertex="1"><mxGeometry width="340" height="30" as="geometry" y="266" /></mxCell><mxCell id="cse_6" parent="tbl_creep_skill_effect" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Tick_Damage (int, NULL)" vertex="1"><mxGeometry width="340" height="30" as="geometry" y="296" /></mxCell><mxCell id="cse_7" parent="tbl_creep_skill_effect" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Tick_Scale_Ratio (numeric, NULL)" vertex="1"><mxGeometry width="340" height="30" as="geometry" y="326" /></mxCell><mxCell id="edge_se_detail" edge="1" parent="1" source="JXMNVE_-JRXyASBiuB6P-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="aidSqVbqEgVGXthLOxOh-29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_se_status" edge="1" parent="1" source="se_0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="FU3Yxe4wLFygVKeGAofF-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_sst_status" edge="1" parent="1" source="sst_status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="FU3Yxe4wLFygVKeGAofF-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_cse_detail" edge="1" parent="1" source="cse_detail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="aidSqVbqEgVGXthLOxOh-80"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_cse_status" edge="1" parent="1" source="cse_0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=2;" target="FU3Yxe4wLFygVKeGAofF-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note_rule_effect" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#FF0000;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;strokeWidth=3;" value="&lt;b&gt;Rule – Skill Effect / Status&lt;/b&gt;&lt;br&gt;1. Skill_Effect (skill của Character) và Creep_Skill_Effect (skill của Creep) cùng cấu trúc; mỗi level skill có thể có nhiều hiệu ứng.&lt;br&gt;2. Passive cộng stat: Stat_Code + Stat_Value (Is_Percent), Duration NULL = vĩnh viễn → cộng vào Character_Stat.&lt;br&gt;3. Buff / debuff: Status_ID trỏ tới Status (stat bị đổi khai báo ở Status_Stat, VD làm chậm: MOVEMENT −30%); Chance = tỉ lệ gây hiệu ứng; Duration ghi đè StatusDuration.&lt;br&gt;4. DOT (độc, bỏng, chảy máu) / HOT: mỗi Tick_Interval gây Tick_Damage + Tick_Scale_Ratio × stat người dùng, loại sát thương = Status.Damage_Type, bị giảm theo Rule – Stat.&lt;br&gt;5. Status đang dính trên Character / Creep chỉ giữ ở game server (không lưu DB), cộng dồn tối đa Max_Stack." vertex="1"><mxGeometry x="1300" y="2180" width="1070" height="170" as="geometry" /></mxCell><mxCell id="tbl_quest_objective" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;" value="Quest_Objective" vertex="1"><mxGeometry x="4130" y="1060" width="340" height="176" as="geometry" /></mxCell><mxCell id="qo_quest" parent="tbl_quest_objective" style="text;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=mi